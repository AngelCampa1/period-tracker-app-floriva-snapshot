{
  "name": "floriva-app",
  "main": "expo-router/entry",
  "version": "1.4.0",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "start:clear": "expo start --dev-client --clear",
    "android": "expo run:android",
    "android:qa:debug-build": "rm -rf android/app/.cxx android/app/build/generated android/app/build/intermediates/cxx android/app/build/intermediates/merged_native_libs && cd android && ./gradlew --no-parallel clean react-native-worklets:prefabDebugPackage react-native-reanimated:prefabDebugPackage app:assembleDebug app:assembleDebugAndroidTest -DtestBuildType=debug",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint app components constants drizzle e2e src tests babel.config.js detox.config.js drizzle.config.ts eslint.config.js jest.config.js metro.config.js sql.d.ts",
    "lint:fix": "eslint app components constants drizzle e2e src tests babel.config.js detox.config.js drizzle.config.ts eslint.config.js jest.config.js metro.config.js sql.d.ts --fix",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "db:generate": "drizzle-kit generate",
    "test": "jest",
    "test:ci": "jest --ci",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=text --coverageReporters=json-summary",
    "test:coverage:check": "pnpm test:coverage && node scripts/check-coverage.js",
    "test:smoke": "jest tests/app",
    "test:imports": "jest tests/sanity",
    "release:preflight": "node scripts/check-release-env.js",
    "corpus:profile": "pnpm exec tsx scripts/profile-import-corpus.ts",
    "test:corpus": "pnpm exec tsx scripts/run-import-corpus.ts",
    "fixtures:generate": "pnpm exec tsx scripts/generate-qa-fixtures.ts",
    "detox:build:ios": "detox build -c ios.sim.debug",
    "detox:test:ios": "detox test -c ios.sim.debug --cleanup",
    "detox:build:android": "detox build -c android.emu.debug",
    "detox:test:android": "detox test -c android.emu.debug --cleanup"
  },
  "dependencies": {
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^2.1.1",
    "@noble/hashes": "^2.0.1",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.1.8",
    "drizzle-orm": "^0.45.2",
    "expo": "~54.0.34",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "^15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-iap": "4.0.1",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^12.8.0",
    "detox": "^20.50.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest-expo": "~54.0.17",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0"
}
